# Telegram bot token from @BotFather
BOT_TOKEN=
# polling (local dev) | webhook (not implemented yet)
BOT_MODE=polling
PORT=3000

# Matches docker-compose.yml's postgres service
DATABASE_URL=postgresql://qrbot:qrbot@localhost:5432/qrbot
# BullMQ queues: sheets-sync (Google Sheets mirror) and qr-decode (HR photos).
# Required in production. Leave empty for local dev without Redis: queues then
# run in-process (no persistence, no retries).
REDIS_URL=redis://localhost:6379

# Event day (YYYY-MM-DD, event time zone Asia/Tashkent). The retention job
# purges participant PII and Click transaction ids on EVENT_DATE + 3 months
# (e.g. 2026-11-15 → 2027-02-15). If unset or malformed the job refuses to
# run and logs an error every day — it never guesses a date.
EVENT_DATE=

# Hard registration cap (participants with a track). Lower it locally to test the "closed" path.
MAX_PARTICIPANTS=1200

# Click Merchant (SHOP API) — from the Click merchant cabinet (merchant.click.uz).
# Leave empty for local onboarding work: the bot still runs, the pay button is
# replaced by a "payment unavailable" message and webhooks answer an error.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
# Never commit or log this value.
CLICK_SECRET_KEY=
# Optional https URL Click sends the payer back to, e.g. https://t.me/<your_bot>
CLICK_RETURN_URL=
# Webhooks to register in the Click cabinet:
#   Prepare URL:  https://<public-host>/click/prepare
#   Complete URL: https://<public-host>/click/complete

# Comma-separated Telegram user ids allowed to run the admin commands
# (/payment_lookup, /refunds, /refund_request, /refund_approve, /hr_add, /hr_list).
ADMIN_TELEGRAM_IDS=

# Google Sheets monitoring mirror (columns A–I synced; J is manual-only).
# Leave empty to run without Sheets: sync jobs wait in Redis until configured.
# The spreadsheet id is the long part of its URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab name holding the table (row 1 = headers). Default: Sheet1
GOOGLE_SHEETS_SHEET_NAME=Sheet1
# Service-account key: a path to the downloaded JSON key file (easiest — e.g.
# secrets/google-service-account.json, gitignored), or the
# JSON itself on one line in single quotes. Never commit or log this value.
GOOGLE_SERVICE_ACCOUNT_JSON=
