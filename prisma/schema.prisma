// Single schema file for the whole app (see .claude/rules/database.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Track {
  JOB
  EDU
}

/// Bot UI language, picked as the first registration step. Mirrors LANGUAGES in src/i18n.
enum LanguageCode {
  uz
  ru
  en
}

model Participant {
  id                String       @id @default(uuid())
  /// Telegram user id of the registrant — one registration per Telegram account.
  /// PII: nulled by the retention purge, like phone, fullName and cvLink.
  telegramId        BigInt?      @unique
  languageCode      LanguageCode
  /// Null only after the retention purge (piiPurgedAt set).
  phone             String?
  /// Null only after the retention purge (piiPurgedAt set).
  fullName          String?
  birthYearOrCourse String
  /// One of DIRECTIONS in src/participants/registration.rules.ts.
  direction         String
  /// Null = not counted against MAX_PARTICIPANTS (which counts active payment
  /// holds — see src/participants/participant-cap.ts).
  track             Track?
  cvLink            String?
  /// Non-guessable token encoded into the QR image — never the raw `id`.
  qrToken           String       @unique
  createdAt         DateTime     @default(now())
  /// First successful HR scan (column H). Set once, never overwritten by a re-scan.
  checkedInAt       DateTime?
  /// The HR user whose scan set checkedInAt.
  checkedInById     String?
  checkedInBy       HrUser?      @relation("CheckIn", fields: [checkedInById], references: [id])
  /// Set by the retention job (src/retention/) when it nulled this row's PII
  /// at EVENT_DATE + 3 months. The row stays for aggregate stats.
  piiPurgedAt       DateTime?

  /// Newest first is the current one; older rows are expired attempts.
  payments   Payment[]
  scanEvents ScanEvent[]
}

/// State machine (see AGENTS.md): pending → paid → refund_requested → refunded, pending → expired.
/// Transitions are enforced in src/payments/payment-state.ts.
enum PaymentStatus {
  pending
  paid
  refund_requested
  refunded
  expired
}

/// The 50 000 so'm Click payment; `id` is the merchant_trans_id sent to Click.
/// A participant has at most one non-expired Payment (enforced under the cap
/// lock); a retry after expiry adds a new row and keeps the expired one.
model Payment {
  id                String        @id @default(uuid())
  participantId     String
  participant       Participant   @relation(fields: [participantId], references: [id])
  status            PaymentStatus @default(pending)
  /// In so'm. Stored, not assumed: Click callbacks are checked against this and PAYMENT_AMOUNT_UZS.
  amount            Int
  /// Click's click_trans_id, recorded on Prepare. Nulled by the retention purge.
  clickTransId      BigInt?       @unique
  /// Our merchant_prepare_id / merchant_confirm_id — Click requires an integer, hence a sequence.
  clickPrepareId    Int           @unique @default(autoincrement())
  /// Set when Click's Prepare succeeded; Complete is only accepted after it.
  preparedAt        DateTime?
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  refundRequestedAt DateTime?
  /// Telegram id of the admin who requested the refund.
  refundRequestedBy BigInt?
  refundedAt        DateTime?
  /// Telegram id of the admin who approved the refund (after refunding in the Click cabinet).
  refundApprovedBy  BigInt?
  /// Set by the expiry job when an unpaid invoice outlived PAYMENT_HOLD_MS.
  expiredAt         DateTime?

  @@index([participantId, createdAt])
  @@index([status, createdAt])
}

model Company {
  id         String      @id @default(uuid())
  /// As written to the Sheets mirror with each decision.
  name       String      @unique
  createdAt  DateTime    @default(now())
  hrUsers    HrUser[]
  scanEvents ScanEvent[]
}

/// A company's HR scanner, identified by Telegram id and bound to exactly one
/// company — every ScanEvent it records carries this companyId.
model HrUser {
  id           String        @id @default(uuid())
  telegramId   BigInt        @unique
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  /// Language of the scanner screens (HR users skip the participant language picker).
  languageCode LanguageCode
  /// Telegram id of the admin who registered this HR user.
  addedBy      BigInt
  createdAt    DateTime      @default(now())
  scanEvents   ScanEvent[]
  checkIns     Participant[] @relation("CheckIn")
}

/// HR shortlist decision (Sheets column I).
enum ScanDecision {
  interview
  internship
  reserve
}

/// Append-only decision history: every button press is a new row, never an
/// update. A company's current decision on a participant is its latest row.
model ScanEvent {
  id            String       @id @default(uuid())
  /// Tie-breaker for "latest" when two rows share a millisecond.
  seq           Int          @unique @default(autoincrement())
  participantId String
  participant   Participant  @relation(fields: [participantId], references: [id])
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  hrUserId      String
  hrUser        HrUser       @relation(fields: [hrUserId], references: [id])
  decision      ScanDecision
  createdAt     DateTime     @default(now())

  @@index([participantId, companyId, createdAt])
}
